# Copy this file to .env and adjust as needed. .env is gitignored.
# None of these are required to run the demo -- every value has a safe default.

# ---- Scraper target ----
# Public scraping sandbox. Do not point this at a site that disallows automation.
SOURCE_BASE_URL=https://books.toscrape.com
TARGET_CATEGORY_SLUG=catalogue/category/books/mystery_3/index.html
MAX_PAGES=2
MAX_RECORDS=25
HEADLESS=true
NAVIGATION_TIMEOUT_MS=15000
FETCH_PRODUCT_DETAIL=true

# ---- Screenshots ----
SCREENSHOTS_ENABLED=true
SCREENSHOT_DIR=screenshots
OUTPUT_DIR=output
LOG_DIR=output/logs

# ---- CRM integration (GoHighLevel-style) ----
# "mock" (default) runs the full sync flow with zero network calls and no
# credentials. Switch to "live" only if you have a real CRM sandbox and
# understand you are sending real HTTP requests.
CRM_MODE=mock

# Only used when CRM_MODE=live. Never commit real values.
CRM_API_BASE_URL=https://services.leadconnectorhq.com
CRM_API_TOKEN=
CRM_LOCATION_ID=

CRM_RETRY_ATTEMPTS=3
CRM_RETRY_BACKOFF_SECONDS=0.5
CRM_REQUEST_TIMEOUT_SECONDS=10
# Mock-mode only: probability [0-1] a mock sync raises a transient error to
# exercise the retry path. Ignored when CRM_MODE=live.
CRM_MOCK_FAILURE_RATE=0.2
